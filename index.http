function screenAdminSettings(){
const s = state.settings;
return `
<div class="flat-bg" style="min-height:100vh;">
<div class="header"><button class="backbtn" style="color:#fff;" data-action="back">${iconSvg("back")}</button><h1 class="chunky" style="color:#fff;">Shop Settings</h1></div>
<div style="padding:0 20px 30px;">
<div class="field field-dark"><label>Shop name</label><input id="asName" value="${esc(s.shop_name||"")}"></div>
<div class="field field-dark"><label>Tagline</label><input id="asTagline" value="${esc(s.tagline||"")}"></div>
<div class="field field-dark"><label>GCash account name</label><input id="asGcashName" value="${esc(s.gcash_name||"")}" placeholder="e.g. Juan Dela Cruz"></div>
<div class="field field-dark"><label>GCash number</label><input id="asGcashNumber" value="${esc(s.gcash_number||"")}" placeholder="09xx xxx xxxx"></div>
<div class="field field-dark"><label>Shipping fee (\u20b1)</label><input id="asShipFee" type="number" step="0.01" value="${s.shipping_fee||0}"></div>
<div class="field field-dark"><label>Facebook Messenger link 1</label><input id="asFb1" value="${esc((s.fb_links||[])[0]||"")}"></div>
<div class="field field-dark"><label>Facebook Messenger link 2</label><input id="asFb2" value="${esc((s.fb_links||[])[1]||"")}"></div>
