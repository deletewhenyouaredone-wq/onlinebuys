<div class="divider"></div>
<div class="row-between" style="cursor:pointer;" data-action="go-address-plain"><span>My Address</span>${iconSvg("chevron")}</div>
</div>
${isAdmin() ? `
<div class="panel row-between">
<span style="font-weight:700;">Viewing as ${effectiveRole()==='admin'?'Admin':'Customer'}</span>
<span class="toggle-track${state.roleView==='admin'?' on':''}" data-action="toggle-role"><span class="toggle-thumb"></span></span>
</div>
<button class="btn btn-ghost-dark btn-block mb16" data-action="go-admin-settings">${iconSvg("settings")} Shop Settings</button>
` : ""}
<button class="btn btn-ghost-dark btn-block" data-action="sign-out">${iconSvg("logout")} Sign Out</button>
</div>
</div>`;
