function screenInbox(){
const last = state.messages[state.messages.length-1];
return `
<div class="flat-bg" style="min-height:100vh;">
<div class="header"><button class="backbtn" style="color:#fff;" data-action="back">${iconSvg("back")}</button><h1 class="chunky" style="color:#fff;">HELLO!</h1><p class="sub" style="color:rgba(255,255,255,0.75);">Message inbox</p></div>
<div style="padding:0 20px 30px;">
${last ? `<div class="msg-row" data-action="go-chat"><div class="avatar">${iconSvg("user")}</div>
<div style="flex:1;overflow:hidden;"><div style="font-weight:800;">${esc(state.settings.shop_name).toUpperCase()}</div>
<div style="font-size:13px;opacity:0.8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(last.message)}</div></div>
<div style="font-size:11px;opacity:0.6;flex-shrink:0;">${formatDateShort(last.created_at)}</div></div>` : `<p class="empty-state" style="color:#fff;">No messages yet.</p>`}
</div>
</div>`;
}
function screenChat(){
const bubbles = state.messages.map(m=>`<div class="bubble ${m.sender==='shop'?'shop':'me'}">${esc(m.message)}</div>`).join("");
return `
<div class="flat-bg" style="min-height:100vh;display:flex;flex-direction:column;">
<div class="header"><button class="backbtn" style="color:#fff;" data-action="back">${iconSvg("back")}</button>
<h1 class="chunky" style="color:#fff;font-size:24px;">${esc(state.settings.shop_name)}</h1><p class="sub" style="color:rgba(255,255,255,0.75);">${esc(state.settings.tagline||"")}</p></div>
<div class="chat-scroll" id="chatScroll">${bubbles || '<p class="empty-state" style="color:#fff;">Say hello!</p>'}</div>
<div class="chat-input-row"><input id="chatInput" placeholder="Message"><button class="chat-send" data-action="send-message">${iconSvg("send")}</button></div>
</div>`;
}
function renderScreen(){
switch(state.screen){
case "landing": return screenLanding();
case "login": return screenLogin();
case "signup": return screenSignup();
case "home": return screenHome();
case "category": return screenCategory();
case "productForm": return screenProductForm();
case "productDetail": return screenProductDetail();
case "checkout": return screenCheckout();
case "addressList": return screenAddressList();
case "addressForm": return screenAddressForm();
case "payment": return screenPayment();
case "purchases": return screenPurchases();
case "profile": return screenProfile();
case "adminSettings": return screenAdminSettings();
case "inbox": return screenInbox();
case "chat": return screenChat();
default: return "<div></div>";
}
}
function render(){
const app = document.getElementById("app");
if(state.loading){
app.innerHTML = `<div class="flat-bg" style="min-height:100vh;display:flex;align-items:center;justify-content:center;"><div class="spinner"></div></div>`;
return;
}
app.innerHTML = renderScreen() + (state.showBuyModal ? buyModalHtml() : "") + (state.categoryModal ? categoryModalHtml() : "");
document.getElementById("app-shell").scrollTop = 0;
if(state.screen==="chat"){ const sc=document.getElementById("chatScroll"); if(sc) sc.scrollTop = sc.scrollHeight; }
}
/* ================= TARGETED UI HELPERS ================= */
function selectPillGroup(action, clickedEl){
document.querySelectorAll(`[data-action="${action}"]`).forEach(el => el.classList.remove("active"));
clickedEl.classList.add("active");
}
function captureOptionValues(){
const inputs = document.querySelectorAll(".optval-input");
if(!inputs.length) return;
const values = [];
inputs.forEach(inp => { values[Number(inp.dataset.idx)] = inp.value; });
formDraft.optionValues = values.length ? values : [""];
}
function refreshOptionValuesUI(){
const wrap = document.getElementById("optValuesWrap");
if(!wrap) return;
wrap.innerHTML = formDraft.optionValues.map((v,i)=>`
<div style="display:flex;gap:8px;margin-bottom:8px;">
<input class="optval-input" data-idx="${i}" value="${esc(v)}" placeholder="${formDraft.optionType==='size'?'e.g. Small':'e.g. Blue'}" style="flex:1;padding:11px 14px;border-radius:12px;border:none;">
<button class="icon-btn-dark" style="border-radius:12px;width:42px;color:#fff;border:none;" data-action="remove-option-value" data-idx="${i}">${iconSvg("x")}</button>
</div>`).join("");
}
function refreshImagesUI(){
const row = document.getElementById("imagesRow");
if(!row) return;
const imagesHtml = formDraft.images.map((img,i)=>`<div class="thumb-wrap"><img src="${esc(img.url)}"><button class="thumb-remove" data-action="remove-image" data-idx="${i}">${iconSvg("x")}</button></div>`).join("");
const addImgBtn = formDraft.images.length < 10 ? `<div class="thumb-add" data-action="pick-images">${iconSvg("plus")}</div>` : "";
row.innerHTML = imagesHtml + addImgBtn;
}
async function handleImageFiles(files){
const remaining = 10 - formDraft.images.length;
const toProcess = files.slice(0, Math.max(0,remaining));
for(const file of toProcess){
try{
const blob = await compressImage(file);
formDraft.images.push({ url: URL.createObjectURL(blob), blob });
}catch(e){ toast("Could not process an image", true); }
}
refreshImagesUI();
const inp = document.getElementById("imageFileInput");
if(inp) inp.value = "";
}
/* ================= DATA LOADERS ================= */
async function loadProfile(){
const rows = await sb.select("profiles", `id=eq.${state.session.user.id}&select=*`);
state.profile = rows[0] || null;
}
async function loadPublicData(){
try{
state.categories = await sb.select("categories", "select=*&order=created_at.asc");
state.products = await sb.select("products", "select=*&order=created_at.asc");
const settingsRows = await sb.select("shop_settings", "select=*&id=eq.1");
if(settingsRows[0]) state.settings = settingsRows[0];
}catch(e){ toast("Could not load shop data: "+e.message, true); }
}
async function loadPersonalData(){
try{
state.addresses = await sb.select("addresses", `user_id=eq.${state.session.user.id}&select=*&order=created_at.asc`);
const orderFilter = isAdmin() ? "select=*&order=created_at.asc" : `user_id=eq.${state.session.user.id}&select=*&order=created_at.asc`;
state.orders = await sb.select("orders", orderFilter);
state.messages = await sb.select("messages", `user_id=eq.${state.session.user.id}&select=*&order=created_at.asc`);
}catch(e){ toast("Could not load your account data: "+e.message, true); }
}
/* ================= AUTH HANDLERS ================= */
async function handleLogin(){
const btn = document.querySelector('[data-action="do-login"]');
const email = document.getElementById("loginEmail").value.trim();
const pw = document.getElementById("loginPw").value;
const errEl = document.getElementById("loginError");
errEl.textContent = "";
if(!email || !pw){ errEl.textContent = "Please enter your email and password."; return; }
btn.disabled = true; btn.textContent = "Logging in...";
try{
const data = await sb.signIn(email, pw);
state.session = data;
storageSet("mc_refresh_token", data.refresh_token);
await loadProfile();
await loadPersonalData();
resetTo("home");
}catch(err){
btn.disabled = false; btn.textContent = "Log in";
errEl.textContent = /invalid/i.test(err.message) ? "Incorrect email or password." : err.message;
}
}
async function handleSignup(){
const btn = document.querySelector('[data-action="do-signup"]');
const name = document.getElementById("suName").value.trim();
const email = document.getElementById("suEmail").value.trim();
const pw = document.getElementById("suPw").value;
const pw2 = document.getElementById("suPw2").value;
const errEl = document.getElementById("signupError");
errEl.textContent = "";
if(!name || !email || !pw){ errEl.textContent = "Please fill in all fields."; return; }
if(pw.length < 6){ errEl.textContent = "Password should be at least 6 characters."; return; }
if(pw !== pw2){ errEl.textContent = "Passwords don't match."; return; }
btn.disabled = true; btn.textContent = "Creating account...";
try{
const data = await sb.signUp(email, pw, name);
if(data.access_token){
state.session = data;
storageSet("mc_refresh_token", data.refresh_token);
await loadProfile();
await loadPersonalData();
resetTo("home");
toast("Welcome, "+name+"!");
} else {
resetTo("login");
toast("Account created! Check your email to confirm, then log in.");
}
}catch(err){
btn.disabled = false; btn.textContent = "Sign up";
errEl.textContent = err.message;
}
}
/* ================= PRODUCT / ORDER HANDLERS ================= */
async function handleSaveProduct(editingId){
const btn = document.querySelector('[data-action="save-product"]');
const name = document.getElementById("pfName").value.trim();
const price = parseFloat(document.getElementById("pfPrice").value);
const description = document.getElementById("pfDesc").value.trim();
const delivery = document.getElementById("pfDelivery").value;
const note = document.getElementById("pfNote").value.trim();
captureOptionValues();
const optionValues = formDraft.optionValues.map(v=>v.trim()).filter(Boolean);
if(!name || !price || !formDraft.categoryId){
toast("Please fill in product name, price, and category.", true);
return;
}
btn.disabled = true; btn.textContent = "Saving...";
try{
const finalImages = [];
for(const img of formDraft.images){
if(img.blob){
const path = `${state.session.user.id}/${Date.now()}-${uid()}.jpg`;
finalImages.push(await sb.upload(path, img.blob));
} else { finalImages.push(img.url); }
}
const payload = {
category_id: formDraft.categoryId, name, price, description,
images: finalImages, delivery_estimate: delivery || null,
option_type: formDraft.optionType, option_values: optionValues,
custom_note: note || "Notes: Customize product have additional fees",
};
let saved;
if(editingId){
const rows = await sb.update("products", `id=eq.${editingId}`, payload);
saved = rows[0];
state.products = state.products.map(p=>p.id===editingId?saved:p);
} else {
const rows = await sb.insert("products", payload);
saved = rows[0];
state.products.push(saved);
}
formDraft = {};
toast("Product saved!");
back();
}catch(err){
btn.disabled = false; btn.textContent = "Save product";
toast(err.message || "Could not save product", true);
}
}
async function handleDoPay(){
const btn = document.querySelector('[data-action="do-pay"]');
const draft = state.buyDraft;
if(!draft){ toast("Nothing to pay.", true); return; }
const addr = state.addresses.find(a=>a.is_default) || state.addresses[0];
if(!addr){ toast("Please add a delivery address first.", true); return; }
const merch = draft.product.price * draft.qty;
const shipFee = state.shippingChoice==='ship' ? Number(state.settings.shipping_fee||0) : 0;
const total = merch + shipFee;
btn.disabled = true; btn.textContent = "Processing...";
try{
const payload = {
user_id: state.session.user.id, product_id: draft.product.id, product_name: draft.product.name,
product_image: (draft.product.images&&draft.product.images[0])||null, variation: draft.selected||null,
quantity: draft.qty, unit_price: draft.product.price, shipping_option: state.shippingChoice,
shipping_fee: shipFee, merchandise_subtotal: merch, total: total, status: "To Deliver",
custom_link: draft.customLink || null,
};
const orderRows = await sb.insert("orders", payload);
state.orders.push(orderRows[0]);
const deliveryText = draft.product.delivery_estimate ? formatDate(draft.product.delivery_estimate) : "the estimated date";
const msgText = `Your order is currently in the preparation stage, and the seller is expected to ship it by the latest ship date of ${deliveryText}. We will remind the seller to ship it as soon as possible. Thank you for your patience.`;
const msgRows = await sb.insert("messages", { user_id: state.session.user.id, sender:"shop", message: msgText });
state.messages.push(msgRows[0]);
state.buyDraft = null; state.showBuyModal = false;
toast("Order placed!");
resetTo("home");
nav("purchases");
}catch(err){
btn.disabled = false; btn.textContent = "Pay";
toast(err.message || "Payment failed", true);
}
}
/* ================= DELEGATED EVENTS ================= */
document.addEventListener("change", async (e) => {
if(e.target && e.target.id === "imageFileInput"){
await handleImageFiles(Array.from(e.target.files||[]));
}
});
document.addEventListener("click", async (e) => {
const el = e.target.closest("[data-action]");
if(!el) return;
const action = el.dataset.action;
const id = el.dataset.id;
const linkInput = document.getElementById("customLinkInput");
if(linkInput && state.buyDraft) state.buyDraft.customLink = linkInput.value;
try{
switch(action){
case "enter": state.session ? resetTo("home") : nav("login"); break;
case "goto-login": nav("login"); break;
case "goto-signup": nav("signup"); break;
case "back": back(); break;
case "toggle-pw": {
const target = document.getElementById(el.dataset.target);
const isPw = target.type === "password";
target.type = isPw ? "text" : "password";
el.innerHTML = isPw ? iconSvg("eyeOff") : iconSvg("eye");
break;
}
case "skip-google": toast("Google sign-in is coming soon!"); break;
case "do-login": await handleLogin(); break;
case "do-signup": await handleSignup(); break;
case "go-profile": nav("profile"); break;
case "go-purchases": nav("purchases"); break;
case "go-inbox": nav("inbox"); break;
case "go-chat": nav("chat"); break;
case "go-admin-settings": nav("adminSettings"); break;
case "open-category": nav("category", { categoryId:id }); break;
case "open-product": carouselIdx = 0; nav("productDetail", { productId:id }); break;
case "add-category": state.categoryModal = {}; render(); break;
case "edit-category": {
const c = state.categories.find(x=>x.id===id);
state.categoryModal = { ...c };
render();
break;
}
case "delete-category": {
if(!confirm("Delete this category? Products inside it will be deleted too.")) break;
await sb.remove("categories", `id=eq.${id}`);
state.categories = state.categories.filter(c=>c.id!==id);
state.products = state.products.filter(p=>p.category_id!==id);
render();
toast("Category deleted");
break;
}
case "save-category": {
const name = document.getElementById("catName").value.trim();
const description = document.getElementById("catDesc").value.trim();
if(!name){ toast("Please enter a category name.", true); break; }
const editId = el.dataset.id;
el.disabled = true; el.textContent = "Saving...";
try{
let saved;
if(editId){
const rows = await sb.update("categories", `id=eq.${editId}`, { name, description });
saved = rows[0];
state.categories = state.categories.map(c=>c.id===editId?saved:c);
} else {
const rows = await sb.insert("categories", { name, description });
saved = rows[0];
state.categories.push(saved);
}
state.categoryModal = null;
render();
toast("Category saved!");
}catch(err){
el.disabled = false; el.textContent = "Save category";
toast(err.message, true);
}
break;
}
case "close-modal-bg":
if(state.showBuyModal) state.showBuyModal = false;
if(state.categoryModal) state.categoryModal = null;
render();
break;
case "close-modal": state.showBuyModal = false; render(); break;
case "close-category-modal": state.categoryModal = null; render(); break;
case "add-product": formDraft = {}; nav("productForm", { categoryId: el.dataset.category }); break;
case "edit-product": formDraft = {}; nav("productForm", { productId:id }); break;
case "delete-product": {
if(!confirm("Delete this product?")) break;
await sb.remove("products", `id=eq.${id}`);
state.products = state.products.filter(p=>p.id!==id);
render();
toast("Product deleted");
break;
}
case "pick-category": formDraft.categoryId = id; selectPillGroup("pick-category", el); break;
case "pick-option-type":
captureOptionValues();
formDraft.optionType = el.dataset.type;
selectPillGroup("pick-option-type", el);
refreshOptionValuesUI();
break;
case "add-option-value":
captureOptionValues();
formDraft.optionValues.push("");
refreshOptionValuesUI();
break;
case "remove-option-value": {
captureOptionValues();
formDraft.optionValues.splice(Number(el.dataset.idx),1);
if(!formDraft.optionValues.length) formDraft.optionValues.push("");
refreshOptionValuesUI();
break;
}
case "pick-images": document.getElementById("imageFileInput").click(); break;
case "remove-image": formDraft.images.splice(Number(el.dataset.idx),1); refreshImagesUI(); break;
case "save-product": await handleSaveProduct(el.dataset.editing); break;
case "carousel-prev": carouselIdx = Math.max(0, carouselIdx-1); render(); break;
case "carousel-next": {
const p = state.products.find(x=>x.id===state.params.productId);
carouselIdx = Math.min(((p&&p.images)||[]).length-1, carouselIdx+1);
render();
break;
}
case "open-buy": {
const p = state.products.find(x=>x.id===id);
state.buyDraft = { product:p, selected:(p.option_values&&p.option_values[0])||null, qty:1, customLink:"", showLinkInput:false };
state.showBuyModal = true;
render();
break;
}
case "pick-buy-option": state.buyDraft.selected = el.dataset.value; selectPillGroup("pick-buy-option", el); break;
case "toggle-link-input": state.buyDraft.showLinkInput = true; render(); break;
case "qty-inc": state.buyDraft.qty++; el.parentElement.querySelector("span").textContent = state.buyDraft.qty; break;
case "qty-dec": state.buyDraft.qty = Math.max(1, state.buyDraft.qty-1); el.parentElement.querySelector("span").textContent = state.buyDraft.qty; break;
case "confirm-buy":
if((state.buyDraft.product.option_values||[]).length && !state.buyDraft.selected){ toast("Please choose an option first.", true); break; }
state.showBuyModal = false; state.shippingChoice = "pickup";
nav("checkout");
break;
case "cancel-checkout": state.showBuyModal = true; back(); break;
case "pick-shipping": state.shippingChoice = el.dataset.value; render(); break;
case "go-address-select": nav("addressList", { selectable:true }); break;
case "go-address-add": nav("addressForm"); break;
case "go-address-plain": nav("addressList", { selectable:false }); break;
case "select-address": {
await sb.update("addresses", `user_id=eq.${state.session.user.id}`, { is_default:false });
await sb.update("addresses", `id=eq.${id}`, { is_default:true });
state.addresses = state.addresses.map(a=>({ ...a, is_default: a.id===id }));
back();
break;
}
case "toggle-default": document.getElementById("defaultToggle").classList.toggle("on"); break;
case "save-address": {
const full_name = document.getElementById("adName").value.trim();
const phone = document.getElementById("adPhone").value.trim();
const region = document.getElementById("adRegion").value.trim();
const city = document.getElementById("adCity").value.trim();
const province = document.getElementById("adProvince").value.trim();
const barangay = document.getElementById("adBarangay").value.trim();
const postal_code = document.getElementById("adPostal").value.trim();
const street = document.getElementById("adStreet").value.trim();
const isDefault = document.getElementById("defaultToggle").classList.contains("on");
if(!full_name || !phone){ toast("Please enter a name and phone number.", true); break; }
el.disabled = true; el.textContent = "Saving...";
try{
if(isDefault) await sb.update("addresses", `user_id=eq.${state.session.user.id}`, { is_default:false });
const rows = await sb.insert("addresses", { user_id: state.session.user.id, full_name, phone, region, city, province, barangay, postal_code, street, is_default:isDefault });
if(isDefault) state.addresses = state.addresses.map(a=>({...a,is_default:false}));
state.addresses.push(rows[0]);
toast("Address saved!");
back();
}catch(err){
el.disabled = false; el.textContent = "Submit";
toast(err.message, true);
}
break;
}
case "go-payment": nav("payment"); break;
case "do-pay": await handleDoPay(); break;
case "toggle-order-status": {
const o = state.orders.find(x=>x.id===id);
const newStatus = o.status === "Delivered" ? "To Deliver" : "Delivered";
await sb.update("orders", `id=eq.${id}`, { status:newStatus });
o.status = newStatus;
render();
break;
}
case "edit-name": {
const wrap = document.getElementById("nameEditWrap");
wrap.innerHTML = `<div style="display:flex;gap:8px;margin-top:10px;">
<input id="nameEditInput" value="${esc(state.profile?.name||"")}" style="flex:1;padding:10px 14px;border-radius:12px;border:none;">
<button class="btn btn-primary btn-sm" data-action="save-name">Save</button></div>`;
document.getElementById("nameEditInput").focus();
break;
}
case "save-name": {
const val = document.getElementById("nameEditInput").value.trim();
if(!val) break;
await sb.update("profiles", `id=eq.${state.session.user.id}`, { name: val });
state.profile.name = val;
document.getElementById("nameEditWrap").innerHTML = "";
document.getElementById("nameDisplay").textContent = val;
break;
}
case "toggle-role": state.roleView = state.roleView==="admin" ? "customer" : "admin"; render(); break;
case "save-settings": {
const shop_name = document.getElementById("asName").value.trim();
const tagline = document.getElementById("asTagline").value.trim();
const gcash_name = document.getElementById("asGcashName").value.trim();
const gcash_number = document.getElementById("asGcashNumber").value.trim();
const shipping_fee = parseFloat(document.getElementById("asShipFee").value) || 0;
const fb1 = document.getElementById("asFb1").value.trim();
const fb2 = document.getElementById("asFb2").value.trim();
el.disabled = true; el.textContent = "Saving...";
try{
const rows = await sb.update("shop_settings", "id=eq.1", { shop_name, tagline, gcash_name, gcash_number, shipping_fee, fb_links:[fb1,fb2].filter(Boolean) });
state.settings = rows[0];
toast("Settings saved!");
back();
}catch(err){
el.disabled = false; el.textContent = "Save settings";
toast(err.message, true);
}
break;
}
case "sign-out":
await sb.signOut();
storageRemove("mc_refresh_token");
state.session = null; state.profile = null; state.addresses=[]; state.orders=[]; state.messages=[];
resetTo("landing");
break;
case "send-message": {
const input = document.getElementById("chatInput");
const text = input.value.trim();
if(!text) break;
input.value = "";
const rows = await sb.insert("messages", { user_id: state.session.user.id, sender:"customer", message:text });
state.messages.push(rows[0]);
render();
break;
}
default: break;
}
}catch(err){
toast(err.message || "Something went wrong", true);
}
});
/* ================= INIT ================= */
async function init(){
try{
const savedRefresh = storageGet("mc_refresh_token");
if(savedRefresh){
try{
const data = await sb.refresh(savedRefresh);
if(data.access_token){
state.session = data;
storageSet("mc_refresh_token", data.refresh_token);
await loadProfile();
}
}catch(e){ storageRemove("mc_refresh_token"); }
}
await loadPublicData();
if(state.session){ await loadPersonalData(); }
}catch(e){ console.error(e); }
state.loading = false;
render();
}
init();
</script>
</body>
</html>
