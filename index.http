return `
<div class="flat-bg" style="min-height:100vh;">
<div class="header"><button class="backbtn" style="color:#fff;" data-action="back">${iconSvg("back")}</button><h1 class="chunky" style="color:#fff;">My Profile</h1></div>
<div class="center-text mb20"><div style="width:88px;height:88px;border-radius:50%;background:rgba(255,255,255,0.2);display:inline-flex;align-items:center;justify-content:center;">${iconSvg("user")}</div></div>
<div style="padding:0 20px 30px;">
<div class="panel">
<div class="row-between" id="nameRow">
<span>Name: <strong id="nameDisplay">${esc(state.profile?.name||"\u2014")}</strong></span>
<button class="icon-btn-dark" style="border-radius:50%;width:30px;height:30px;color:#fff;border:none;" data-action="edit-name">${iconSvg("pencil")}</button>
</div>
<div id="nameEditWrap"></div>
<div class="divider"></div>
